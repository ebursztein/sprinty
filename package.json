{
  "name": "sprinty-mcp",
  "version": "0.2.1",
  "description": "Disciplined sprint MCP with dashboard, artifacts, gates, Git-backed change maps, and changelogs for Claude Code, Codex, and Gemini",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Elie Bursztein",
  "homepage": "https://github.com/ebursztein/sprinty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebursztein/sprinty.git"
  },
  "bugs": {
    "url": "https://github.com/ebursztein/sprinty/issues"
  },
  "keywords": [
    "mcp",
    "sprint",
    "codex",
    "claude",
    "gemini",
    "dashboard",
    "artifacts",
    "gates",
    "changelog",
    "ledger"
  ],
  "bin": {
    "sprinty-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "clients",
    "plugins",
    ".agents",
    ".claude-plugin",
    "docs/sprinty-dashboard.png",
    "plugin.json",
    "mcp.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dashboard": "vite build --config vite.dashboard.config.ts",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run --exclude src/tools/response-size.test.ts && vitest run src/tools/response-size.test.ts --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest",
    "_comment:test:coverage": "One sequential run, not the two-phase split of `test`: response-size.test.ts asserts wall-clock budgets that only hold without parallel load, and two separate vitest runs would each overwrite the other's coverage report.",
    "test:coverage": "vitest run --coverage --no-file-parallelism --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dashboard.json",
    "sync:skills": "node scripts/sync-skills.mjs",
    "start": "node dist/index.js",
    "dev:dashboard": "vite --config vite.dashboard.config.ts",
    "build:site": "node scripts/build-site.mjs",
    "dev:site": "python3 -m http.server 4174 --bind 127.0.0.1 --directory website"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.10",
    "marked": "^18.0.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@untitledui/icons": "^0.0.23",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
